---
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PROJECTS, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 5);
---

<Base title={SITE_TITLE}>
	<h1>Hi, I'm hkbarton.</h1>
	<p>
		I build small apps as a hobby and occasionally write about it. <!-- TODO: write your own intro -->
	</p>

	<h2>Projects</h2>
	<ul class="plain">
		{
			PROJECTS.map((p) => (
				<li>
					<a href={p.url}>{p.name}</a> — {p.description}
				</li>
			))
		}
	</ul>

	{
		recent.length > 0 && (
			<>
				<h2>Recent posts</h2>
				<ul class="plain posts">
					{recent.map((post) => (
						<li>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
							<FormattedDate date={post.data.pubDate} />
						</li>
					))}
				</ul>
				<p>
					<a href="/blog">All posts</a>
				</p>
			</>
		)
	}
</Base>
