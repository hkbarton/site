---
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PROJECTS, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 5);

/**
 * Links off this site open in a new tab. Anything relative stays in the current
 * one, so adding an internal path to PROJECTS still behaves normally.
 * `rel="noopener"` stops the opened page reaching back through `window.opener`.
 */
function externalLinkProps(url: string) {
	if (!/^https?:\/\//i.test(url)) return {};
	return { target: '_blank', rel: 'noopener noreferrer' };
}
---

<Base title={SITE_TITLE}>
	<h1>Hi, I'm hkbarton.</h1>
	<p>
    Software Enginner/Dad, love playing games(PC/Consoles), building small things and eating spicy food. I speak/write in both English and Chinese.
	</p>
	<p>
    软件工程师/孩子他爹，喜欢玩游戏，做一些小玩意儿和吃麻辣的食物。
	</p>

	<h2>Projects</h2>
	<ul class="plain">
		{
			PROJECTS.map((p) => (
				<li>
					<a href={p.url} {...externalLinkProps(p.url)}>
						{p.name}
					</a>{' '}
					— {p.description}
				</li>
			))
		}
	</ul>

	{
		recent.length > 0 && (
			<>
				<h2>Recent posts</h2>
				<ul class="plain posts">
					{recent.map((post) => (
						<li>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
							<FormattedDate date={post.data.pubDate} lang={post.data.lang} />
						</li>
					))}
				</ul>
				<p>
					<a href="/blog">All posts</a>
				</p>
			</>
		)
	}
</Base>
