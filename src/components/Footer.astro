---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} {SITE_TITLE} · <a href="/rss.xml">RSS</a></p>
</footer>

<style>
	footer {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 3rem var(--gutter) 2rem;
		color: var(--fg-muted);
		font-size: 0.875rem;
	}
	p {
		margin: 0;
	}
	a {
		color: inherit;
	}
</style>
