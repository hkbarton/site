---
import { SITE_LANG } from '../consts';

interface Props {
	date: Date;
	/** BCP 47 tag. Defaults to the site language. */
	lang?: string;
}

const { date, lang = SITE_LANG } = Astro.props;

const formatted = date.toLocaleDateString(lang, {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={date.toISOString()} lang={lang}>{formatted}</time>
