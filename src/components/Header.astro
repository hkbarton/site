---
import { NAV_LINKS, SITE_TITLE } from '../consts';

/**
 * `build.format: 'file'` means prerendering sees `/blog.html` and `/index.html`,
 * while the dev server and SSR see `/blog` and `/`. Normalise to the URL a
 * visitor actually has, or nothing ever matches and no link is ever marked
 * current.
 */
function normalise(pathname: string) {
	const stripped = pathname
		.replace(/\/index\.html$/, '/')
		.replace(/\.html$/, '')
		.replace(/(.)\/$/, '$1');
	return stripped === '' ? '/' : stripped;
}

const path = normalise(Astro.url.pathname);

/** Current for the page itself and anything nested below it. */
function isCurrent(href: string) {
	return path === href || path.startsWith(`${href}/`);
}
---

<header>
	<nav aria-label="Site">
		<a href="/" class="home" aria-current={path === '/' ? 'page' : undefined}>{SITE_TITLE}</a>
		{
			NAV_LINKS.map((link) => (
				<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.5rem var(--gutter) 0;
	}
	nav {
		display: flex;
		gap: 1.25rem;
		align-items: baseline;
		flex-wrap: wrap;
	}
	a {
		color: var(--fg-muted);
		text-decoration: none;
	}
	a:hover,
	a[aria-current='page'] {
		color: var(--fg);
	}
	.home {
		font-weight: 700;
		color: var(--fg);
	}
</style>
