{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Must match the Worker that Cloudflare's git-push build deploys to. Workers
	// Builds named it after the repository, so it is "site", not "hkbarton".
	// Changing this would deploy to a second, separate Worker.
	"name": "site",
	// Pinned on purpose. Bumping it changes runtime behaviour; do it in its own commit.
	"compatibility_date": "2026-09-11",
	// `nodejs_compat` is required: the Keystatic admin API imports `node:fs`.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
		// Keystatic's admin is a client-side router, so /keystatic/<anything> has
		// no matching static asset. Without this, `not_found_handling: "404-page"`
		// makes the asset worker answer browser *navigations* (Sec-Fetch-Mode:
		// navigate) with 404.html and never reach the Worker, so every admin route
		// below /keystatic 404s in a browser while curl sees 200. Send these paths
		// to the Worker first. Everything else keeps normal asset handling.
		"run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*"]
	},
	"observability": {
		"enabled": true
	}
}
