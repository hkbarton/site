# Keystatic GitHub mode. The GitHub App connection flow at /keystatic produces
# all four values. Copy this file to .env for local dev.
#
# These three are read at RUNTIME, through getSecret() from astro:env/server,
# which the Cloudflare adapter maps to the Worker's env. In production set them
# as Worker secrets:  wrangler secret put <NAME>
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# This one is different. Keystatic's admin UI reads it through import.meta.env,
# so it is inlined into the client bundle at BUILD time. A Worker secret will
# not reach it. Set it as a build-time environment variable wherever the build
# runs: this .env locally, or the Workers Build settings for git-push deploys.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
